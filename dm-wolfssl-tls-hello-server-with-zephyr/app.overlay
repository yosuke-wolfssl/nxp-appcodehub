/ {
};

/* Re-layout MCUboot image slots: 0x80000 each */
/delete-node/ &slot0_partition;
/delete-node/ &slot1_partition;

&flash {
	partitions {
		slot0_partition: partition@10000 {
			label = "image-0";
			reg = <0x10000 0xC0000>;
		};

		slot1_partition: partition@90000 {
			label = "image-1";
			reg = <0xD0000 0xC0000>;
		};
	};
};
